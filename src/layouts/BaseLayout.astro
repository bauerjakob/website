---
import "../styles/base/_index.scss";
import { site } from "../data/site";

const { author: a } = site;
const title = `${a.firstname} ${a.lastname} | ${a.headline}`;
---

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <title>{title}</title>
        <meta name="description" content={a.bio} />
        <meta name="theme-color" content="#0a0d13" />
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <link
            rel="preload"
            href="/fonts/HackRegular.woff"
            as="font"
            type="font/woff"
            crossorigin
        />
        <link
            rel="preload"
            href="/fonts/HackBold.woff"
            as="font"
            type="font/woff"
            crossorigin
        />
        <meta
            name="viewport"
            content="width=device-width, height=device-height, initial-scale=1"
        />
    </head>
    <body>
        <main class="container" id="main">
            <slot name="main"><slot /></slot>
        </main>
    </body>
</html>
