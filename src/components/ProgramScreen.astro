---
import { site } from "../data/site";

interface Props {
    tabs: { id: string; label: string }[];
}

const { tabs } = Astro.props;
const firstname = site.author.firstname.toLowerCase();
const resizeEdges = ["n", "e", "s", "w", "ne", "nw", "se", "sw"];
---

<div id="closed" class="closed" hidden>
    <button id="reopen" class="reopen" type="button">
        <span class="app-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none">
                <defs>
                    <linearGradient
                        id="app-icon-stroke"
                        gradientUnits="userSpaceOnUse"
                        x1="8"
                        y1="12"
                        x2="40"
                        y2="36"
                    >
                        <stop offset="0" stop-color="hsl(152, 62%, 62%)"></stop>
                        <stop offset="1" stop-color="hsl(190, 78%, 66%)"></stop>
                    </linearGradient>
                </defs>
                <g
                    stroke="url(#app-icon-stroke)"
                    stroke-width="3.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="M12 15l10 9-10 9"></path>
                    <path class="app-icon-cursor" d="M26 33h10"></path>
                </g>
            </svg>
        </span>
        <span class="reopen-label">Reopen terminal</span>
    </button>
</div>

<div id="terminal" class="window">
    <header id="titlebar" class="titlebar">
        <div class="lights">
            <button
                id="close-button"
                class="light close"
                type="button"
                aria-label="Close window"></button>
            <button
                id="minimize-button"
                class="light minimize"
                type="button"
                aria-label="Minimize window"></button>
            <button
                id="maximize-button"
                class="light maximize"
                type="button"
                aria-label="Maximize window"></button>
        </div>
    </header>

    <div id="scroller" class="scroller" tabindex="0">
        <slot />
        <div id="output" class="output" aria-live="polite"></div>
    </div>

    <form id="prompt" class="prompt" autocomplete="off">
        <label for="command">
            <span class="sr-only">Command</span>
            <span aria-hidden="true">~ ❯</span>
        </label>
        <input
            id="command"
            type="text"
            placeholder='type "help"'
            spellcheck="false"
            autocapitalize="off"
            autocomplete="off"
        />
    </form>

    <nav class="statusbar" aria-label="Sections">
        <span class="session">{firstname}</span>
        <ul>
            {
                tabs.map((tab, i) => (
                    <li>
                        <a
                            href={`#${tab.id}`}
                            data-tab
                            aria-current={i === 0 ? "true" : undefined}
                        >
                            {i}:{tab.label}
                        </a>
                    </li>
                ))
            }
        </ul>
    </nav>

    {
        resizeEdges.map((edge) => (
            <div class="resize-handle" data-edge={edge} aria-hidden="true" />
        ))
    }
</div>

<style lang="scss">
    @use "../styles/mixins/windowed" as *;

    .closed:not([hidden]) {
        grid-row: 1;
        display: grid;
        justify-items: center;
        padding: 1rem;
        animation: closed-in 0.4s cubic-bezier(0.2, 1.2, 0.35, 1);
    }

    @keyframes closed-in {
        from {
            opacity: 0;
            transform: translateY(10px) scale(0.92);
        }
    }

    .reopen {
        display: grid;
        justify-items: center;
        gap: 0.8rem;
        padding: 0.75rem 1rem;
        border: 0;
        border-radius: 14px;
        background: none;
        color: hsl(var(--dim));
        cursor: pointer;

        &:hover .app-icon {
            translate: 0 -3px;
            border-color: hsla(var(--accent), 0.55);
            box-shadow: inset 0 1px 0 hsla(0, 0%, 100%, 0.08),
                0 18px 40px -14px hsla(var(--accent), 0.35);
        }

        &:hover .reopen-label {
            color: hsl(var(--accent));
        }
    }

    .app-icon {
        display: block;
        width: 5.5rem;
        height: 5.5rem;
        padding: 1rem;
        border: 1px solid var(--hairline);
        border-radius: 1.4rem;
        background: linear-gradient(
            160deg,
            hsl(222, 24%, 17%),
            hsl(224, 30%, 9%)
        );
        box-shadow: inset 0 1px 0 hsla(0, 0%, 100%, 0.08),
            0 18px 40px -14px rgba(0, 0, 0, 0.7);
        transition: translate 0.2s ease-out, border-color 0.2s, box-shadow 0.2s;
    }

    .app-icon-cursor {
        animation: cursor-blink 1.2s steps(1) infinite;
    }

    @keyframes cursor-blink {
        50% {
            opacity: 0;
        }
    }

    .reopen-label {
        font-size: 0.8125rem;
        transition: color 0.2s;
    }

    .window {
        --radius: 0px;
        position: relative;
        grid-row: 1;
        display: flex;
        flex-direction: column;
        width: 100%;
        min-width: 0;
        min-height: 100vh;
        min-height: 100dvh;
        background: hsl(var(--base-darker));
        animation: window-fade 0.35s ease-out;

        &[hidden] {
            display: none;
        }

        @include windowed {
            --radius: 13px;
            width: min(60rem, calc(100% - 3rem));
            height: min(48rem, calc(100vh - 5rem));
            height: min(48rem, calc(100dvh - 5rem));
            min-height: 0;
            animation: window-open 0.5s cubic-bezier(0.2, 1.2, 0.35, 1);
            border: 1px solid var(--hairline);
            border-radius: 14px;
            background: hsla(var(--base-darker), 0.78);
            -webkit-backdrop-filter: blur(28px) saturate(150%);
            backdrop-filter: blur(28px) saturate(150%);
            box-shadow: inset 0 1px 0 hsla(0, 0%, 100%, 0.06),
                0 40px 100px -24px rgba(0, 0, 0, 0.75),
                0 12px 32px -12px rgba(0, 0, 0, 0.5);

            &.is-max {
                --radius: 0px;
                position: fixed;
                inset: 0;
                z-index: 10;
                width: auto !important;
                height: auto !important;
                translate: none !important;
                border: 0;
                border-radius: 0;
            }
        }
    }

    @keyframes window-fade {
        from {
            opacity: 0;
        }
    }

    @keyframes window-open {
        from {
            opacity: 0;
            transform: translateY(20px) scale(0.84);
        }
    }

    .resize-handle {
        display: none;

        @include windowed {
            display: block;
            position: absolute;
            z-index: 3;
            touch-action: none;

            .is-max & {
                display: none;
            }
        }

        &[data-edge="n"],
        &[data-edge="s"] {
            left: 12px;
            right: 12px;
            height: 10px;
            cursor: ns-resize;
        }

        &[data-edge="e"],
        &[data-edge="w"] {
            top: 12px;
            bottom: 12px;
            width: 10px;
            cursor: ew-resize;
        }

        &[data-edge="ne"],
        &[data-edge="nw"],
        &[data-edge="se"],
        &[data-edge="sw"] {
            width: 18px;
            height: 18px;
        }

        &[data-edge="nw"],
        &[data-edge="se"] {
            cursor: nwse-resize;
        }

        &[data-edge="ne"],
        &[data-edge="sw"] {
            cursor: nesw-resize;
        }

        // Handles straddle the border so the scrollbar stays usable.
        &[data-edge*="n"] {
            top: -7px;
        }

        &[data-edge*="s"] {
            bottom: -7px;
        }

        &[data-edge*="e"] {
            right: -7px;
        }

        &[data-edge*="w"] {
            left: -7px;
        }
    }

    .titlebar {
        position: sticky;
        top: 0;
        z-index: 2;
        flex: none;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        height: 2.5rem;
        padding: 0 0.9rem;
        border-bottom: 1px solid var(--hairline);
        border-radius: var(--radius) var(--radius) 0 0;
        background: hsl(var(--base-darker));
        user-select: none;
        -webkit-user-select: none;

        @include windowed {
            position: static;
            background: hsla(0, 0%, 100%, 0.03);
            cursor: grab;
            touch-action: none;

            .is-max & {
                cursor: default;
            }
        }
    }

    .lights {
        display: flex;
        gap: 8px;
    }

    .light {
        position: relative;
        width: 12px;
        height: 12px;
        padding: 0;
        border: 0;
        border-radius: 50%;
        background: #ff5f57;
        color: transparent;
        font: 700 10px/12px system-ui, sans-serif;
        pointer-events: none;

        @include windowed {
            pointer-events: auto;
            cursor: default;
        }

        // larger hit area than the visible dot
        &::after {
            content: "";
            position: absolute;
            inset: -4px;
        }

        &::before {
            content: "×";
        }

        &.minimize {
            background: #febc2e;

            &::before {
                content: "−";
            }

            .is-max & {
                background: #eeeeee52;
                color: transparent !important;
            }
        }

        &.maximize {
            background: #28c840;

            &::before {
                content: "+";
            }
        }
    }

    .lights:hover .light {
        color: rgba(0, 0, 0, 0.6);
    }

    .scroller {
        flex: 1 1 auto;
        min-width: 0;

        @include windowed {
            min-height: 0;
            overflow-y: auto;
            overscroll-behavior: contain;
            scrollbar-width: thin;
            scrollbar-color: hsla(220, 40%, 88%, 0.18) transparent;
        }
    }

    .output {
        padding: 0 2rem 1.25rem;
        white-space: pre-wrap;
        color: hsl(var(--dim));

        &:empty {
            display: none;
        }

        :global(.echo) {
            margin-top: 0.75rem;
            color: hsl(var(--accent));
            font-weight: 700;
        }
    }

    .prompt {
        display: none;

        @include windowed {
            flex: none;
            display: flex;
            align-items: center;
            gap: 1ch;
            padding: 0.7rem 2rem;
            border-top: 1px solid var(--hairline);
            transition: background-color 0.2s;

            &:focus-within {
                background: hsla(var(--accent), 0.05);
            }
        }

        label {
            color: hsl(var(--accent));
            font-weight: 700;
        }

        input {
            flex: 1;
            min-width: 0;
            padding: 0;
            border: 0;
            outline: 0;
            background: transparent;
            color: hsl(var(--txtc));
            caret-color: hsl(var(--accent));

            &::placeholder {
                color: hsl(var(--dim));
            }
        }
    }

    .statusbar {
        position: sticky;
        bottom: 0;
        z-index: 2;
        flex: none;
        display: flex;
        align-items: stretch;
        height: 2.75rem;
        overflow-x: auto;
        scrollbar-width: none;
        border-top: 1px solid var(--hairline);
        border-radius: 0 0 var(--radius) var(--radius);
        background: hsl(var(--base-darker));
        font-size: 0.75rem;
        color: hsl(var(--dim));

        @include windowed {
            position: static;
            height: 1.75rem;
            background: hsla(0, 0%, 100%, 0.03);
        }

        ul {
            display: flex;
        }

        li,
        a {
            display: flex;
            align-items: center;
        }

        a {
            // narrow enough that all tabs fit on a 320px screen
            padding: 0 clamp(0.3rem, 1.6vw, 0.6rem);
            white-space: nowrap;
            transition: color 0.15s;

            &:hover {
                color: hsl(var(--txtc));
            }

            &[aria-current] {
                color: hsl(var(--accent));
                font-weight: 700;
            }
        }
    }

    .session {
        display: none;

        @include windowed {
            display: flex;
            align-items: center;
            padding: 0 1rem 0 0.75rem;
            margin-right: 0.25rem;
            background: hsl(var(--accent));
            color: hsl(var(--base));
            font-weight: 700;
            clip-path: polygon(
                0 0,
                calc(100% - 7px) 0,
                100% 50%,
                calc(100% - 7px) 100%,
                0 100%
            );
        }
    }
</style>

<script>
    // Keep in sync with the `windowed` SCSS mixin.
    const WINDOWED = window.matchMedia(
        "(min-width: 48rem) and (min-height: 32rem)"
    );
    const REDUCED_MOTION = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
    );

    function byId<T extends HTMLElement = HTMLElement>(id: string): T {
        const element = document.getElementById(id);
        if (!element) throw new Error(`Missing element #${id}`);
        return element as T;
    }

    const terminal = byId("terminal");
    const titlebar = byId("titlebar");
    const scroller = byId("scroller");
    const output = byId("output");
    const closedScreen = byId("closed");
    const promptForm = byId<HTMLFormElement>("prompt");
    const promptInput = byId<HTMLInputElement>("command");
    const blocks = Array.from(
        document.querySelectorAll<HTMLElement>("[data-command]")
    );
    const tabs = Array.from(
        document.querySelectorAll<HTMLAnchorElement>("[data-tab]")
    );

    // --- window controls ---

    let maximized = false;

    function setMaximized(value: boolean) {
        maximized = value;
        terminal.classList.toggle("is-max", value);
    }

    type ExitKind = "close" | "minimize";

    const EXIT_MS: Record<ExitKind, number> = { close: 170, minimize: 340 };
    let exiting = false;

    function exitTransform(kind: ExitKind) {
        if (kind === "close") return "translateY(8px) scale(0.92)";

        // shrink toward the bottom center of the screen, like into a dock
        const rect = terminal.getBoundingClientRect();
        const dx = window.innerWidth / 2 - (rect.left + rect.width / 2);
        const dy = window.innerHeight - (rect.top + rect.height / 2);
        return `translate(${dx}px, ${dy}px) scale(0.08)`;
    }

    async function hideWindow(kind: ExitKind) {
        if (!WINDOWED.matches || terminal.hidden || exiting) return;

        exiting = true;
        const animation = terminal.animate(
            [
                { opacity: 1, transform: "none" },
                { opacity: 0, transform: exitTransform(kind) },
            ],
            {
                duration: REDUCED_MOTION.matches ? 0 : EXIT_MS[kind],
                easing: "cubic-bezier(0.4, 0, 1, 1)",
                fill: "forwards",
            }
        );
        await animation.finished;

        terminal.hidden = true;
        closedScreen.hidden = false;
        animation.cancel();
        exiting = false;
    }

    byId("close-button").addEventListener("click", () => {
        void hideWindow("close");
    });
    byId("minimize-button").addEventListener("click", () => {
        if (!maximized) void hideWindow("minimize");
    });
    byId("maximize-button").addEventListener("click", () => {
        if (WINDOWED.matches) setMaximized(!maximized);
    });
    byId("reopen").addEventListener("click", () => {
        closedScreen.hidden = true;
        terminal.hidden = false; // showing it replays the CSS open animation
        blocks.forEach((block) => block.classList.remove("flash"));
        keepOnScreen();
    });

    // --- dragging and resizing ---

    const MIN_WIDTH = 480;
    const MIN_HEIGHT = 320;

    const offset = { x: 0, y: 0 };
    let dragStart: { x: number; y: number } | null = null;
    let resizeStart: {
        edge: string;
        x: number;
        y: number;
        rect: DOMRect;
    } | null = null;

    function clamp(value: number, min: number, max: number) {
        return Math.min(Math.max(value, min), max);
    }

    // Moves the window relative to its centered position, keeping it on screen.
    // Offset metrics ignore transforms, so the open animation can't skew them.
    // They are rounded, and the -1 keeps that rounding from causing a scrollbar.
    function moveTo(x: number, y: number) {
        const { offsetLeft, offsetTop, offsetWidth, offsetHeight } = terminal;
        const maxX = window.innerWidth - offsetWidth - offsetLeft - 1;
        const maxY = window.innerHeight - offsetHeight - offsetTop - 1;
        offset.x = clamp(x, -offsetLeft, maxX);
        offset.y = clamp(y, -offsetTop, maxY);
        terminal.style.translate = `${offset.x}px ${offset.y}px`;
    }

    // Applies a size and viewport position. The window is centered by the page
    // layout, so changing its size also shifts it and the offset compensates.
    function setFrame(left: number, top: number, width: number, height: number) {
        terminal.style.width = `${width}px`;
        terminal.style.height = `${height}px`;
        const rect = terminal.getBoundingClientRect();
        offset.x += left - rect.left;
        offset.y += top - rect.top;
        terminal.style.translate = `${offset.x}px ${offset.y}px`;
    }

    function keepOnScreen() {
        if (!WINDOWED.matches || maximized) return;
        if (terminal.style.width) {
            const width = Math.min(terminal.offsetWidth, window.innerWidth);
            const height = Math.min(terminal.offsetHeight, window.innerHeight);
            terminal.style.width = `${width}px`;
            terminal.style.height = `${height}px`;
        }
        moveTo(offset.x, offset.y);
    }

    function beginInteraction(cursor: string) {
        document.body.style.setProperty("--drag-cursor", cursor);
        document.body.classList.add("is-dragging");
    }

    function endInteraction() {
        dragStart = null;
        resizeStart = null;
        document.body.classList.remove("is-dragging");
    }

    titlebar.addEventListener("pointerdown", (event) => {
        const onButton = (event.target as Element).closest("button");
        if (!WINDOWED.matches || maximized || onButton || event.button !== 0) {
            return;
        }
        titlebar.setPointerCapture(event.pointerId);
        dragStart = {
            x: event.clientX - offset.x,
            y: event.clientY - offset.y,
        };
        beginInteraction("grabbing");
    });

    titlebar.addEventListener("pointermove", (event) => {
        if (dragStart) {
            moveTo(event.clientX - dragStart.x, event.clientY - dragStart.y);
        }
    });

    titlebar.addEventListener("pointerup", endInteraction);
    titlebar.addEventListener("pointercancel", endInteraction);

    for (const handle of document.querySelectorAll<HTMLElement>("[data-edge]")) {
        handle.addEventListener("pointerdown", (event) => {
            if (event.button !== 0) return;
            handle.setPointerCapture(event.pointerId);
            resizeStart = {
                edge: handle.dataset.edge ?? "",
                x: event.clientX,
                y: event.clientY,
                rect: terminal.getBoundingClientRect(),
            };
            beginInteraction(getComputedStyle(handle).cursor);
        });

        handle.addEventListener("pointermove", (event) => {
            if (!resizeStart) return;

            const { edge, x, y, rect } = resizeStart;
            const dx = event.clientX - x;
            const dy = event.clientY - y;
            let { left, top, right, bottom } = rect;

            if (edge.includes("e")) {
                right = clamp(right + dx, left + MIN_WIDTH, window.innerWidth);
            }
            if (edge.includes("s")) {
                bottom = clamp(bottom + dy, top + MIN_HEIGHT, window.innerHeight);
            }
            if (edge.includes("w")) {
                left = clamp(left + dx, 0, right - MIN_WIDTH);
            }
            if (edge.includes("n")) {
                top = clamp(top + dy, 0, bottom - MIN_HEIGHT);
            }

            setFrame(left, top, right - left, bottom - top);
        });

        handle.addEventListener("pointerup", endInteraction);
        handle.addEventListener("pointercancel", endInteraction);
    }

    window.addEventListener("resize", () => {
        if (!terminal.hidden) keepOnScreen();
    });

    WINDOWED.addEventListener("change", () => {
        if (WINDOWED.matches) return;
        endInteraction();
        setMaximized(false);
        offset.x = 0;
        offset.y = 0;
        terminal.style.translate = "";
        terminal.style.width = "";
        terminal.style.height = "";
    });

    // --- section navigation ---

    function jumpTo(block: HTMLElement) {
        block.scrollIntoView({
            block: "start",
            behavior: REDUCED_MOTION.matches ? "auto" : "smooth",
        });
        block.classList.remove("flash");
        void block.offsetWidth; // restarts the highlight animation
        block.classList.add("flash");
    }

    for (const tab of tabs) {
        tab.addEventListener("click", (event) => {
            const id = tab.getAttribute("href")?.slice(1) ?? "";
            const block = document.getElementById(id);
            if (block) {
                event.preventDefault();
                jumpTo(block);
            }
        });
    }

    function updateActiveTab() {
        const windowed = WINDOWED.matches;
        const top = windowed ? scroller.getBoundingClientRect().top : 0;
        const height = windowed ? scroller.clientHeight : window.innerHeight;
        const page = document.documentElement;
        const scrolled = windowed ? scroller.scrollTop : window.scrollY;
        const scrollMax = windowed
            ? scroller.scrollHeight - scroller.clientHeight
            : page.scrollHeight - window.innerHeight;

        let current = blocks[0];
        for (const block of blocks) {
            if (block.getBoundingClientRect().top <= top + height * 0.3) {
                current = block;
            }
        }
        if (scrolled > 0 && scrolled >= scrollMax - 2) {
            current = blocks[blocks.length - 1];
        }

        for (const tab of tabs) {
            if (tab.getAttribute("href") === `#${current.id}`) {
                tab.setAttribute("aria-current", "true");
            } else {
                tab.removeAttribute("aria-current");
            }
        }
    }

    scroller.addEventListener("scroll", updateActiveTab, { passive: true });
    window.addEventListener("scroll", updateActiveTab, { passive: true });
    window.addEventListener("resize", updateActiveTab);

    // --- prompt ---

    const HELP = [
        "about  work  skills  awards  contact    jump to a section",
        "clear                                   clear command output",
        "crt                                     toggle the CRT effect",
        "exit                                    close the terminal",
    ].join("\n");

    const commands = new Map<string, () => string | void>([
        ["help", () => HELP],
        [
            "clear",
            () => {
                output.replaceChildren();
                scroller.scrollTo({ top: 0 });
            },
        ],
        [
            "crt",
            () => {
                const on = document.body.classList.toggle("crt");
                return `CRT effect ${on ? "on" : "off"}.`;
            },
        ],
        [
            "exit",
            () => {
                void hideWindow("close");
            },
        ],
        ["contact", () => jumpTo(byId("home"))],
    ]);

    for (const block of blocks) {
        const jump = () => jumpTo(block);
        commands.set(block.id, jump);
        commands.set(block.dataset.command ?? block.id, jump);
    }

    function print(line: string, result: string) {
        const echo = document.createElement("p");
        echo.className = "echo";
        echo.textContent = `~ ❯ ${line}`;
        const text = document.createElement("p");
        text.textContent = result;
        output.append(echo, text);
        scroller.scrollTo({ top: scroller.scrollHeight });
    }

    promptForm.addEventListener("submit", (event) => {
        event.preventDefault();
        const line = promptInput.value.trim();
        promptInput.value = "";
        if (!line) return;

        const command = commands.get(line.toLowerCase());
        const result = command
            ? command()
            : `zsh: command not found: ${line}`;
        if (result) print(line, result);
    });

    // Clicking into the terminal focuses the prompt, like a real one.
    scroller.addEventListener("click", (event) => {
        const onControl = (event.target as Element).closest("a, button");
        if (!WINDOWED.matches || onControl || window.getSelection()?.toString()) {
            return;
        }
        promptInput.focus({ preventScroll: true });
    });
</script>
